[Unit]
Description=LuminAqua - Week Aqua light controller
After=bluetooth.service network-online.target
Wants=bluetooth.service network-online.target

[Service]
# setup-pi.sh fills in the user and folder
User=pi
WorkingDirectory=/home/pi/luminaqua
# Port 80 so the address is just http://<hostname>.local
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/home/pi/luminaqua/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
